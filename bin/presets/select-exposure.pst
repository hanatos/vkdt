# brighten a selection by one stop, using a click selection.
# see [the documentation of the select module](../../../src/pipe/modules/select/readme.md).
module:select:sel:1000:180
module:guided:sel:1175:180
module:exposure:sel:1000:620
module:blend:sel:1350:400
connect:colour:01:output:select:sel:input
connect:colour:01:output:guided:sel:input
connect:select:sel:output:guided:sel:guide
connect:colour:01:output:exposure:sel:input
connect:colour:01:output:blend:sel:back
connect:exposure:sel:output:blend:sel:input
connect:guided:sel:output:blend:sel:mask
connect:blend:sel:output:filmcurv:01:input
param:select:sel:click:0
param:guided:sel:radius:0.01
param:guided:sel:epsilon:0.01
param:exposure:sel:exposure:1
param:blend:sel:opacity:1
param:blend:sel:taathrs:0
param:blend:sel:mode:0
param:blend:sel:mask:1
