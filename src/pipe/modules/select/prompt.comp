#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16: enable

#include "shared.glsl"
#include "params.glsl"
layout(local_size_x = DT_LOCAL_SIZE_X, local_size_y = DT_LOCAL_SIZE_Y, local_size_z = 1) in;
layout(push_constant, std140) uniform push_t { ivec2 net; int grid; int run; int prev; } push;
layout(std430, set = 1, binding = 0) readonly  buffer in_t   { float16_t v[]; } inp;
layout(std430, set = 1, binding = 1) readonly  buffer prev_t { float16_t v[]; } prev;
layout(std430, set = 1, binding = 2) readonly  buffer crop_t { vec4 c[]; } reg;
layout(std430, set = 1, binding = 3) writeonly buffer out_t  { float16_t v[]; } buf;

float logit(ivec2 p)
{
  p = clamp(p, ivec2(0), ivec2(push.grid-1));
  return float(prev.v[push.grid * p.y + p.x]);
}

void main()
{
  const ivec2 net = push.net;
  ivec2 ipos = ivec2(gl_GlobalInvocationID);
  if(any(greaterThanEqual(ipos, net))) return;

  const vec4 c = reg.c[0];
  const vec2 csz = c.zw - c.xy;

  // positive and negative click disks of radius 5 at network resolution
  vec2 pos = vec2(0.0);
  // run 0: first click or box only, last run (zoom): all clicks
  const int nclk = clamp(int(clk(0)), 0, 21);
  const int runs = clamp(nclk + int(has_box()), 1, 5);
  const int cnt = push.run == 0 ? int(!has_box() && nclk > 0) : clamp(nclk - runs + 1 + push.run, 0, nclk);
  for(int i=0;i<cnt;i++)
  {
    vec2 p = vec2(clk(1+3*i), clk(2+3*i));
    if(any(lessThan(p, c.xy)) || any(greaterThan(p, c.zw))) continue;
    ivec2 cp = clamp(ivec2((p - c.xy) / csz * vec2(net)), ivec2(0), net-1);
    ivec2 d = ipos - cp;
    if(d.x*d.x + d.y*d.y <= 25)
    {
      if(clk(3+3*i) > 0.5) pos.x = 1.0;
      else                 pos.y = 1.0;
    }
  }

  // mask of the previous run, logits interpolated bilinearly
  float m = 0.0;
  const vec4 r = reg.c[1];
  const vec2 u = c.xy + csz * (ipos + 0.5) / vec2(net);
  if(push.prev > 0 && all(greaterThanEqual(u, r.xy)) && all(lessThan(u, r.zw)))
  {
    const vec2 q = (u - r.xy) / (r.zw - r.xy) * push.grid - 0.5;
    const ivec2 p0 = ivec2(floor(q));
    const vec2 f = q - p0;
    const float z = mix(
        mix(logit(p0),              logit(p0 + ivec2(1, 0)), f.x),
        mix(logit(p0 + ivec2(0, 1)), logit(p0 + ivec2(1, 1)), f.x), f.y);
    m = 1.0/(1.0 + exp(-z));
  }

  const int idx = 8*(net.x*ipos.y + ipos.x);
  buf.v[idx+0] = inp.v[idx+0];
  buf.v[idx+1] = inp.v[idx+1];
  buf.v[idx+2] = inp.v[idx+2];
  buf.v[idx+3] = float16_t(pos.x);
  buf.v[idx+4] = float16_t(pos.y);
  buf.v[idx+5] = inp.v[idx+5];
  buf.v[idx+6] = max(inp.v[idx+6], float16_t(m));
  buf.v[idx+7] = float16_t(0.0);
}
