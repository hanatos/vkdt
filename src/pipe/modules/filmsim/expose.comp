#version 460
#extension GL_GOOGLE_include_directive    : enable
#include "head.glsl"
#include "state.glsl"
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1) uniform sampler2D img_coeff;
layout(set = 1, binding = 2, std430) readonly buffer buf_prep_t { filmsim_state_t prep; };
layout(set = 1, binding = 3) uniform writeonly restrict image2D img_out;
layout(set = 1, binding = 4) uniform writeonly restrict image2D img_exp;
#include "state_ops.glsl"
#include "exposure.glsl"

void main()
{
  FILMSIM_BOUNDS_INIT(ipos);
  vec3 rgb = texelFetch(img_in, ipos, 0).rgb;
  vec3 log_raw = clamp(expose_scene_to_film(img_coeff, rgb), vec3(-4.0), vec3(4.0));

  // cwarp and development share this gamma-corrected axis.
  log_raw = clamp(params.gamma_film * log_raw, vec3(-4.0), vec3(4.0));

  vec3 coupler = vec3(0.0);
  [[branch]] if (params.couplers > 0)
    coupler = clamp(coupler_inhibit_pre_blur(eval_film_density(log_raw)), vec3(-10.0), vec3(10.0));

  imageStore(img_out, ipos, vec4(coupler, 1));
  imageStore(img_exp, ipos, vec4(log_raw, 1));
}
