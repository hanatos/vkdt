#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_control_flow_attributes : enable
#include "shared.glsl"
layout(local_size_x = DT_LOCAL_SIZE_X, local_size_y = DT_LOCAL_SIZE_Y, local_size_z = 1) in;
layout(std140, set = 0, binding = 1) uniform params_t
{
  float t;     // threshold to detect a hot pixel
  int chn;     // apply to which channels
  float sigma; // threshold in deviations of the noise or the spread
} params;
layout(push_constant, std140) uniform push_t
{
  ivec2 crop;
  int filters;
  float black, white;     // in [0,1] of the 16 bit input
  float noise_a, noise_b; // noise profile, zero if there is none
} push;
layout(set = 1, binding = 0) uniform sampler2D img_in;
layout(set = 1, binding = 1) uniform writeonly image2D img_out;

// the red and blue photosites of the 5x5 window, a bit at 5y + x, by where the
// mosaic pattern aligns with its top left corner. the rest is green. x-trans:
//   G R G G B G
//   B G B R G R
//   G R G G B G
//   G B G G R G
//   R G R B G B
//   G B G G R G
// which swaps red and blue when moved by three in x or y
ivec2 window_mask(ivec2 ph)
{
  if(push.filters != 9) // R G, G B
  {
    const ivec2 m = ((ph.x ^ ph.y) & 1) == 0 ? ivec2(0x1505415, 0x0050140) : ivec2(0x0a0280a, 0x00a82a0);
    return (ph.y & 1) == 0 ? m : m.yx;
  }
  const bvec2 far = greaterThanEqual(ph, ivec2(3));
  const ivec2 p = ph - 3*ivec2(far);
  const ivec2 m =
    p.y == 0 ? (p.x == 0 ? ivec2(0x0580902, 0x08140b0) : p.x == 1 ? ivec2(0x0240681, 0x140a048) : ivec2(0x1120140, 0x0a01224)) :
    p.y == 1 ? (p.x == 0 ? ivec2(0x102c048, 0x0240a05) : p.x == 1 ? ivec2(0x0812034, 0x01a0502) : ivec2(0x048900a, 0x0050091)) :
               (p.x == 0 ? ivec2(0x0281602, 0x1012050) : p.x == 1 ? ivec2(0x0140901, 0x080d028) : ivec2(0x0024480, 0x0402804));
  return far.x != far.y ? m.yx : m;
}

bool profiled() { return push.noise_a > 0.0 || push.noise_b > 0.0; }

float noise(float level)
{
  const float range = push.white - push.black;
  return sqrt(max(0.0, push.noise_a + push.noise_b * max(0.0, (level - push.black) / range))) * range;
}

// how far above its colour around a photosite has to be to stand out:
// sigma deviations of the noise at the level, or of the spread
float threshold(float level, float spread)
{
  if(!profiled()) return max(params.t * (push.white - push.black), params.sigma * spread);
  return params.sigma * max(noise(level), spread);
}

// normal order statistics (cf. blom 1958), simulated for n = 3..16 samples of unit
// noise without the brightest two and fit in n to about 1%: how far their mean is low
// (the expected two largest over n - 2), their spread relative to the deviation, and
// the spread of a further sample around the corrected mean (about sqrt(1 + 1/n))
float trim_bias(float n)   { return 2.7375 / (n + 0.4674) + 0.0541; }
float trim_spread(float n) { return 0.9034 - 1.7465 / (n - 0.735); }
float trim_scale(float n)  { return 1.0 + 0.4554 / (n - 1.1484); }

// mean and deviation of n >= 3 samples (each colour has that in a 5x5 window), estimated
// without the brightest two, so that hot photosites next to each other still stand out
vec2 background(float sum, float sum2, float top1, float top2, float n)
{
  const float mean = (sum - (top1 + top2)) / (n - 2.0);
  const float spread = n > 3.0 ? sqrt(max(0.0, (sum2 - (top1*top1 + top2*top2)) / (n - 2.0) - mean*mean)) / trim_spread(n) : 0.0;
  return vec2(mean + trim_bias(n) * (profiled() ? max(noise(mean), spread) : spread), spread);
}

// a real light reaches the other colours around through the lens with this much of
// its excess, a hot photosite only with noise (measured on lights and defects at night)
const float spill = 0.25;

// the own colour's entry of a vector, without indexing it
int pick(bvec3 col, ivec3 v) { return col.x ? v.x : col.z ? v.z : v.y; }

// the workgroup and 4 before and 2 after, as far as the window moves at the edges
#define TILE_X (DT_LOCAL_SIZE_X + 6)
#define TILE_Y (DT_LOCAL_SIZE_Y + 6)
shared float tile[TILE_Y][TILE_X];

void main()
{
  const ivec2 ipos = ivec2(gl_GlobalInvocationID);
  const ivec2 size = textureSize(img_in, 0);
  const ivec2 base = ivec2(gl_WorkGroupID.xy) * ivec2(DT_LOCAL_SIZE_X, DT_LOCAL_SIZE_Y) - 4;
  const int i = int(gl_LocalInvocationIndex); // one gather each, fits for workgroups of 6x6 and up
  if(i < TILE_X*TILE_Y/4)
  {
    const ivec2 q = 2*ivec2(i % (TILE_X/2), i / (TILE_X/2));
    const vec4 g = textureGather(img_in, vec2(base + q + 1) / vec2(size), 0);
    tile[q.y][q.x] = g.w; tile[q.y][q.x+1] = g.z; tile[q.y+1][q.x] = g.x; tile[q.y+1][q.x+1] = g.y;
  }
  barrier();
  if(any(greaterThanEqual(ipos, imageSize(img_out)))) return;
  float v = tile[ipos.y - base.y][ipos.x - base.x];

  // the 5x5 window, moved inside the image at the edges: a bit per photosite at 5y + x
  const ivec2 origin = clamp(ipos - 2, ivec2(0), max(size - 5, ivec2(0)));
  const ivec2 ph = ((origin - push.crop.xy) % 6 + 6) % 6; // this is where the mosaic pattern aligns
  ivec3 mask;
  mask.xz = window_mask(ph);
  mask.y = ~(mask.x | mask.z) & 0x1ffffff;
  const ivec2 o = ipos - origin;
  const int self = 1 << (5*o.y + o.x);
  const bvec3 col = notEqual(mask & self, ivec3(0));
  if((params.chn & pick(col, ivec3(1, 2, 4))) == 0) { imageStore(img_out, ipos, vec4(v)); return; }
  mask &= ~self;
  const int own = pick(col, mask);
#define AT(m, x, y) (((m) & (1 << (5*(y) + (x)))) != 0)

  const ivec2 t = origin - base;
  float w[5][5];
  [[unroll]] for(int y = 0; y < 5; y++) [[unroll]] for(int x = 0; x < 5; x++)
    w[y][x] = tile[t.y + y][t.x + x];

  // the own colour: the darkest, the brightest three, the sums and the count, without v
  float lo = v, top1 = -1.0, top2 = -1.0, top3 = -1.0, sum = 0.0, sum2 = 0.0, n = 0.0;
  [[unroll]] for(int y = 0; y < 5; y++) [[unroll]] for(int x = 0; x < 5; x++)
  {
    if(!AT(own, x, y)) continue;
    const float u = w[y][x];
    lo = min(lo, u);
    top3 = max(top3, min(top2, u)); top2 = max(top2, min(top1, u)); top1 = max(top1, u);
    sum += u; sum2 += u*u; n += 1.0;
  }
  // the background is no darker than that, so the threshold is at least the noise
  // there: done early if three are within that of v (less a margin for rounding)
  if(top3 >= v - 0.99 * threshold(lo, 0.0)) { imageStore(img_out, ipos, vec4(v)); return; }

  const vec2 bg = background(sum, sum2, top1, top2, n);
  if(v - bg.x > trim_scale(n) * threshold(bg.x, bg.y))
  { // keep v if two or more in the window are raised too, one of another colour
    const vec3 cnt = vec3(bitCount(mask));
    vec3 ctop1 = vec3(-1.0), ctop2 = vec3(-1.0), csum = vec3(0.0), csum2 = vec3(0.0);
    [[unroll]] for(int y = 0; y < 5; y++) [[unroll]] for(int x = 0; x < 5; x++)
    {
      const bvec3 m = bvec3(AT(mask.x, x, y), AT(mask.y, x, y), AT(mask.z, x, y));
      const vec3 um = mix(vec3(-1.0), vec3(w[y][x]), m), u0 = mix(vec3(0.0), vec3(w[y][x]), m);
      ctop2 = max(ctop2, min(ctop1, um)); ctop1 = max(ctop1, um);
      csum += u0; csum2 += u0*u0;
    }
    ivec3 up;
    [[unroll]] for(int i = 0; i < 3; i++)
    {
      const vec2 t = background(csum[i], csum2[i], ctop1[i], ctop2[i], cnt[i]);
      const float thr = max(max(threshold(t.x, 0.0), 1.5*t.y), spill * (v - bg.x));
      up[i] = int(ctop1[i] - t.x > thr) + int(ctop2[i] - t.x > thr);
    }
    const int raised = up.r + up.g + up.b;
    if(raised < 2 || raised == pick(col, up)) v = bg.x;
  }
  imageStore(img_out, ipos, vec4(v));
}
